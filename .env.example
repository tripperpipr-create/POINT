# Host directory mounted into the container as /workspace.
WORKSPACE_PATH=./examples/go-health
# Browser URL: http://127.0.0.1:${WORKBENCH_PORT}
WORKBENCH_PORT=8080
# Shared bearer token for the Docker API and nginx reverse proxy.
# Replace this value for any shared or non-loopback environment.
POINT_API_TOKEN=point-docker-dev-token-change-me

# Desktop/core execution backend. Production releases must use docker together
# with the fail-closed strong-isolation gate. The image is never pulled during
# an agent run; build or install it ahead of time.
POINT_SANDBOX_BACKEND=docker
POINT_SANDBOX_REQUIRE_STRONG=true
POINT_SANDBOX_IMAGE=point-agent-sandbox:1.2.2
POINT_SANDBOX_MEMORY=2g
POINT_SANDBOX_CPUS=2
POINT_SANDBOX_PIDS=256
